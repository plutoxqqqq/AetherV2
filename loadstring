-- Give each person a different value for key.
-- You can set these through getgenv() before running this file, or edit the defaults below.
local env = (getgenv and getgenv()) or _G
local endpoint = (env and env.AetherV2SourceEndpoint) or 'https://aetherv2.onrender.com'
local key = (env and env.AetherV2Key) or 'PASTE_ASSIGNED_KEY_HERE'

endpoint = tostring(endpoint):gsub('/+$', '')
assert(endpoint ~= '', 'AetherV2 source endpoint is missing')
assert(key ~= '' and key ~= 'PASTE_ASSIGNED_KEY_HERE', 'Paste the assigned AetherV2 key first')

local function encode(value)
    return tostring(value):gsub('([^%w%-%._~])', function(character)
        return string.format('%%%02X', string.byte(character))
    end)
end

loadstring(game:HttpGet(endpoint..'/loader?key='..encode(key), true), 'aether-key-bootstrap')()
